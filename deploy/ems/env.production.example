# Copy to /home/ems/.env on the server and replace secrets.

# Public hostname (must match TLS certificate and DNS A record).
EMS_DOMAIN=emsmobile.icloud-solutions.net

# Let's Encrypt registration email (required for obtain-cert.sh).
CERTBOT_EMAIL=ops@icloud-solutions.net

# Docker publishes nginx on this host port (default 18080 when host nginx already uses :80).
EMS_PUBLISH_HTTP=18080

APP_NAME=altatheeb-mobile-backend
APP_ENV=production
LOG_LEVEL=INFO

# CORS: include your HTTPS admin origin.
ALLOWED_CORS_ORIGINS=https://emsmobile.icloud-solutions.net

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Odoo gateway (server-to-server)
ODOO_BASE_URL=https://your-odoo-host.example.com
ODOO_SERVICE_TOKEN=
USER_CONTEXT_SECRET=

# Must match Odoo ems_mobile_gateway.outbound_secret
ODOO_INBOUND_HMAC_SECRET=

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

MIN_APP_VERSION_ANDROID=1.0.0
MIN_APP_VERSION_IOS=1.0.0

POSTGRES_PASSWORD=ems

# First admin for mobile admin web (/). Created by: docker compose exec backend python scripts/seed_local.py
INITIAL_ADMIN_LOGIN=admin@emsmobile.icloud-solutions.net
INITIAL_ADMIN_EMAIL=admin@emsmobile.icloud-solutions.net
INITIAL_ADMIN_FULL_NAME=EMS Administrator
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
