# --- Application
APP_NAME=altatheeb-mobile-backend
APP_ENV=local
LOG_LEVEL=INFO
ALLOWED_CORS_ORIGINS=http://localhost:5173

# --- Database / cache
DATABASE_URL=postgresql+psycopg2://ems:ems@localhost:5432/ems_mobile
REDIS_URL=redis://localhost:6379/0

# --- JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Odoo gateway (server-to-server)
ODOO_BASE_URL=http://localhost:8069
ODOO_SERVICE_TOKEN=replace-with-token-from-odoo-settings
USER_CONTEXT_SECRET=replace-with-secret-from-odoo-settings

# --- Webhooks coming FROM Odoo
ODOO_INBOUND_HMAC_SECRET=replace-with-outbound-secret-from-odoo-settings

# --- FCM
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# --- App version gate
MIN_APP_VERSION_ANDROID=1.0.0
MIN_APP_VERSION_IOS=1.0.0
